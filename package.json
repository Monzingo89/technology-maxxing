{
  "name": "ai-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "scripts": {
    "video:deploy": "firebase deploy --config firebase.video.json --project ai-space-f1d31 --only firestore:rules,storage,functions:ai-space:videoOwnerStatus,functions:ai-space:requestTopicVideo,functions:ai-space:generateTopicVideo,functions:ai-space:processVideoUpload,functions:ai-space:publishTopicVideo,functions:ai-space:discardTopicVideo,functions:ai-space:recordVideoView --non-interactive",
    "video:secrets": "node scripts/configure-video-secrets.mjs",
    "test:video-security": "firebase emulators:exec --project demo-video-security --only auth,firestore,storage \"node scripts/test-video-rules.mjs && node scripts/test-video-backend.mjs\"",
    "test:video-media": "node scripts/test-video-media.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-standards.mjs && node scripts/build-knowledge.mjs && tsc -b && vite build",
    "preview:pages": "npm run build && vite preview --host 127.0.0.1 --port 4173",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/site.test.mjs scripts/workbench.test.mjs functions/test/*.test.js",
    "catalog:ai": "node scripts/build-ai-library.mjs && node scripts/build-knowledge.mjs",
    "catalog:ai:refresh": "node scripts/research-ai-catalog.mjs && node scripts/research-model-history.mjs && node scripts/research-google-prices.mjs && npm run catalog:ai",
    "native:sync": "npm run build && cap sync",
    "test:e2e": "playwright test",
    "audit:assessments": "node scripts/audit-assessments.mjs",
    "test:emulators": "firebase emulators:exec --project demo-ai-space --only auth,firestore,functions \"node functions/test/emulator.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/src/*.js\" \"tests/*.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.6.9",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
