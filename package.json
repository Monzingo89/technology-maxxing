{
  "name": "ai-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-knowledge.mjs && tsc -b && vite build",
    "preview:pages": "npm run build && vite preview --host 127.0.0.1 --port 4173",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/site.test.mjs functions/test/*.test.js",
    "native:sync": "npm run build && cap sync",
    "test:e2e": "playwright test",
    "test:emulators": "firebase emulators:exec --project demo-ai-space --only auth,firestore,functions \"node functions/test/emulator.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/src/*.js\" \"tests/*.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.6.9",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
